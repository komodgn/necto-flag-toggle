{
  "schemaVersion": 1,
  "id": "io.github.komodgn.necto-flag-toggle",
  "name": "Flag Toggle",
  "description": "Remotely toggle an app's boolean flag from the necto sidebar",
  "version": "0.1.0",
  "author": "komodgn",
  "icon": { "systemName": "arrow.left.arrow.right" },
  "assets": ["index.html", "assets"],
  "allowedOrigins": ["self"],
  "operations": [
    {
      "id": "flag.config", "title": "Config", "description": "Panel display strings",
      "kind": "once", "binding": { "name": "necto.device.flag.config", "version": 1 },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "type": "object", "properties": { "title": { "type": "string" }, "onLabel": { "type": "string" }, "offLabel": { "type": "string" }, "note": { "type": "string" } }, "required": ["title", "onLabel", "offLabel", "note"], "additionalProperties": false },
      "timeoutMs": 3000
    },
    {
      "id": "flag.get", "title": "Get", "description": "Current value",
      "kind": "once", "binding": { "name": "necto.device.flag.get", "version": 1 },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "type": "object", "properties": { "on": { "type": "boolean" } }, "required": ["on"], "additionalProperties": false },
      "timeoutMs": 3000
    },
    {
      "id": "flag.toggle", "title": "Toggle", "description": "Flip the value",
      "kind": "once", "binding": { "name": "necto.device.flag.toggle", "version": 1 },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "type": "object", "properties": { "on": { "type": "boolean" } }, "required": ["on"], "additionalProperties": false },
      "timeoutMs": 3000
    },
    {
      "id": "flag.enable", "title": "Enable", "description": "Force ON",
      "kind": "once", "binding": { "name": "necto.device.flag.enable", "version": 1 },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "type": "object", "properties": { "on": { "type": "boolean" } }, "required": ["on"], "additionalProperties": false },
      "timeoutMs": 3000
    },
    {
      "id": "flag.disable", "title": "Disable", "description": "Force OFF",
      "kind": "once", "binding": { "name": "necto.device.flag.disable", "version": 1 },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "type": "object", "properties": { "on": { "type": "boolean" } }, "required": ["on"], "additionalProperties": false },
      "timeoutMs": 3000
    },
    {
      "id": "flag.reset", "title": "Reset", "description": "Clear override",
      "kind": "once", "binding": { "name": "necto.device.flag.reset", "version": 1 },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "type": "object", "properties": { "on": { "type": "boolean" } }, "required": ["on"], "additionalProperties": false },
      "timeoutMs": 3000
    }
  ]
}
